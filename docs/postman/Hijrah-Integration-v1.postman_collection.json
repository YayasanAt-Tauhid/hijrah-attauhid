{
  "info": {
    "name": "Hijrah Integration API v1.1",
    "description": "Backward-compatible Hijrah /api/v1 integration: scoped read/sync, granular scopes, employee read/import/update, SPMB filters, and optional scoped milestone updates. Never place the bearer token in browser/mobile code.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://app.hijrah-attauhid.or.id"
    },
    {
      "key": "token",
      "value": "REPLACE_WITH_BACKEND_TOKEN",
      "type": "secret"
    },
    {
      "key": "pendaftaranId",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "siswaId",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "kelasId",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "pegawaiId",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "checkpoint",
      "value": "0"
    },
    {
      "key": "departemenId",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "tahunAjaranId",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "gelombangId",
      "value": "00000000-0000-4000-8000-000000000001"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Pendaftaran",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pendaftaran?limit=100",
            "description": "Filters: departemen_id, tahun_ajaran_id, status, status_tes, status_kelulusan, gelombang_id, status_verifikasi. Token scope remains the maximum boundary."
          }
        },
        {
          "name": "List - Filter SPMB",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/pendaftaran?limit=100&departemen_id={{departemenId}}&tahun_ajaran_id={{tahunAjaranId}}&gelombang_id={{gelombangId}}&status_tes=belum_tes",
            "description": "Example v1.1 filter. Replace UUID variables with values allowed by this token."
          },
          "response": []
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pendaftaran/{{pendaftaranId}}"
          }
        }
      ]
    },
    {
      "name": "Siswa",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/siswa?limit=100",
            "description": "Filters: departemen_id, tahun_ajaran_id, status, kelas_id."
          }
        },
        {
          "name": "List - Filter Kelas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/siswa?limit=100&departemen_id={{departemenId}}&tahun_ajaran_id={{tahunAjaranId}}&kelas_id={{kelasId}}",
            "description": "Returns students matching the requested class/year while respecting token scopes."
          },
          "response": []
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/siswa/{{siswaId}}"
          }
        }
      ]
    },
    {
      "name": "Kelas",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/kelas?limit=100",
            "description": "Filters: departemen_id and tahun_ajaran_id."
          }
        },
        {
          "name": "Siswa Kelas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/kelas/{{kelasId}}/siswa?tahun_ajaran_id={{tahunAjaranId}}",
            "description": "Filter tahun_ajaran_id benar-benar diterapkan server-side dan tetap dibatasi oleh scope token."
          }
        }
      ]
    },
    {
      "name": "Pegawai",
      "description": "GET requires pegawai:read. Biodata/contact requires pegawai:contact:read. Bulk import/update requires pegawai:write. Department restrictions apply.",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pegawai?limit=100&departemen_id={{departemenId}}&status=aktif",
            "description": "Data dasar pegawai. Tambahkan scope pegawai:contact:read bila memerlukan blok data_pribadi."
          },
          "response": []
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pegawai/{{pegawaiId}}"
          },
          "response": []
        },
        {
          "name": "Import / Update",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pegawai/import",
            "description": "Requires pegawai:write. Max 200 rows. Match existing by pegawai_id first, then NIP. This endpoint does not change roles/login, attendance, savings, journals, payments, or finance tables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"update_existing\": true,\n  \"rows\": [\n    {\n      \"pegawai_id\": \"{{pegawaiId}}\",\n      \"nip\": \"19870001\",\n      \"nama\": \"Ahmad Fulan\",\n      \"jabatan\": \"Guru\",\n      \"departemen_id\": \"{{departemenId}}\",\n      \"status\": \"aktif\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Incremental Sync",
      "description": "For bootstrap, capture the first sync checkpoint before finishing list snapshots; then resume from that checkpoint.",
      "item": [
        {
          "name": "Pendaftaran - initial checkpoint",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/sync/pendaftaran?limit=1"
          }
        },
        {
          "name": "Pendaftaran - from checkpoint",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/sync/pendaftaran?limit=100&checkpoint={{checkpoint}}"
          }
        },
        {
          "name": "Siswa",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/sync/siswa?limit=100&checkpoint={{checkpoint}}"
          }
        },
        {
          "name": "Kelas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/sync/kelas?limit=100&checkpoint={{checkpoint}}"
          }
        }
      ]
    },
    {
      "name": "Dokumen",
      "item": [
        {
          "name": "KK signed URL",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{pendaftaranId}}.kk"
          }
        },
        {
          "name": "Akta signed URL",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{pendaftaranId}}.akta"
          }
        },
        {
          "name": "Rapor signed URL",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{pendaftaranId}}.rapor"
          }
        },
        {
          "name": "Ijazah signed URL",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{pendaftaranId}}.ijazah"
          }
        }
      ]
    },
    {
      "name": "SPMB Milestone",
      "description": "Requires pendaftaran:milestone:update. Use tes first, then choose lulus or tidak_lulus. Repeating the same action is idempotent; daftar_ulang is not available through this API.",
      "item": [
        {
          "name": "tes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pendaftaran/{{pendaftaranId}}/milestone",
            "body": {
              "mode": "raw",
              "raw": "{\"action\": \"tes\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "lulus",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pendaftaran/{{pendaftaranId}}/milestone",
            "body": {
              "mode": "raw",
              "raw": "{\"action\": \"lulus\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "tidak_lulus",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/pendaftaran/{{pendaftaranId}}/milestone",
            "body": {
              "mode": "raw",
              "raw": "{\"action\": \"tidak_lulus\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
